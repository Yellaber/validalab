# ─────────────────────────────────────────────────────────────────────────────
# ValidaLab — backend · plantilla de variables de entorno
#
# Copia este archivo a `.env` y rellena los valores. El backend VALIDA estas
# variables al arrancar (fail-fast): si falta una obligatoria o es inválida, el
# proceso aborta el arranque. No subas tu `.env` real al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# --- Aplicación ---
# Entorno de ejecución. Valores: development | test | production
NODE_ENV=development
# Puerto HTTP del servidor. Opcional (por defecto 3000).
PORT=3000

# --- PostgreSQL (TypeORM) ---
# Conexión a la base de datos. Todas obligatorias.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=validalab
DB_PASSWORD=cambia-esto
DB_DATABASE=validalab
# Sincronización automática de esquema. DEBE quedar en false salvo en un arranque
# local desechable. El esquema real se gobierna con migraciones de TypeORM.
DB_SYNCHRONIZE=false

# --- JWT (verificación del accessToken) ---
# Secreto para verificar la firma del accessToken. Obligatorio. Usa un valor
# largo y aleatorio (p. ej. `openssl rand -hex 32`). La EMISIÓN de tokens vive en
# el módulo `usuarios`; esta fundación solo VERIFICA.
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Tiempo de vida del accessToken (formato de `ms`/jsonwebtoken, p. ej. 15m, 1h).
JWT_ACCESS_TTL=15m

# --- Sesión / refresh token ---
# Vigencia del refresh token opaco (se almacena hasheado). Formato `ms` (p. ej. 30d).
REFRESH_TOKEN_TTL=30d

# --- BYOK (configuración del proveedor de IA por usuario) ---
# Clave AES-256 (32 bytes = 64 caracteres hex) para cifrar en reposo las API keys
# BYOK. Obligatoria. Genérala con `openssl rand -hex 32`. Si la pierdes, las keys
# cifradas quedan irrecuperables (el usuario debe reconfigurar su BYOK).
BYOK_CLAVE_CIFRADO=cambia-esto-por-64-caracteres-hexadecimales-openssl-rand-hex-32
# Validar la API key contra el proveedor real al guardarla. true en producción.
# Ponlo en false SOLO en dev/test para aceptar cualquier key no vacía sin salir a
# los proveedores. Opcional (por defecto true).
BYOK_VALIDAR_KEY=true

# --- Agente (Validador Inteligente) ---
# Modo de la capa agéntica: real | fake. `fake` produce un scoring determinista
# sin invocar a ningún proveedor ni salir a la red (dev/test). Opcional (real).
AGENTE_MODO=real
# Límite de iteraciones del grafo por ejecución. Opcional (por defecto 6).
AGENTE_MAX_ITERACIONES=6
# Timeout por ejecución del agente, en milisegundos. Opcional (por defecto 30000).
AGENTE_TIMEOUT_MS=30000
# Reintentos ante salida que no cumple el esquema Zod. Opcional (por defecto 2).
AGENTE_MAX_REINTENTOS=2
# Versión de la rúbrica de scoring (participa en el hash de idempotencia). Súbela
# para invalidar todos los scores previos sin tocar datos. Opcional (por defecto v2).
SCORING_VERSION_RUBRICA=v2
